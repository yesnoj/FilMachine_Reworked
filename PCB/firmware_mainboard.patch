-    mcp23017_digitalWrite(&mcp, WB_RLY, 0);          /* close valve             */
+    mcp23017_digitalWrite(&mcp, FILL_VALVE, 0);      /* close the mains inlet   */
     ESP_LOGI(TAG, "Machine fill ended (state=%d, %lu ml)", s_fillState, (unsigned long)s_fillVolumeMl);
     vTaskDelete(NULL);
 }
